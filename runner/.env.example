# このファイルをコピーして runner/.env を作り、使うチェーンの値だけ埋めてください。
#   cp runner/.env.example runner/.env
# runner/.env は .gitignore 済みなので、コミットもクラウド送信もされません。
# （環境変数で渡す場合はこのファイル不要）
# チェーンごとに別の変数です。混用しません（T・ジョイ系は KINEZO、109シネマズは C109）。

# --- KINEZO（T・ジョイ横浜 / 新宿バルト9 / T・ジョイ京都・梅田 / 横浜ブルク13）---
KINEZO_EMAIL=あなたのKINEZO会員メールアドレス
KINEZO_PASSWORD=あなたのKINEZO会員パスワード

# --- 109シネマズ（川崎 / プレミアム新宿）シネマポイント会員 ---
# ID はメールアドレス／ログインID／会員番号(16桁)のいずれか
C109_ID=あなたの109会員ID
C109_PASSWORD=あなたの109会員パスワード

# --- TOHOシネマズ（任意）---
# 未設定ならログインなしの「ゲスト購入」経路で座席指定まで進みます（現状 TOHO-ONE ログインの自動化は未対応のため、設定しても使われません）。
# TOHO_ID=
# TOHO_PASSWORD=

# --- チネチッタ（任意）---
# 未設定ならゲスト購入で座席指定まで進みます（会員ログインの自動化は未対応）。
# CINECITTA_ID=
# CINECITTA_PASSWORD=

# --- シネマサンシャイン（任意）---
# 未設定ならゲスト購入で座席指定まで進みます（会員ログインの自動化は未対応）。
# SUNSHINE_ID=
# SUNSHINE_PASSWORD=

# --- 映画ランド eigaland（新文芸坐 友の会など・任意）---
# 未設定でもゲストで座席確保まで進めます。会員先行（一般より早い枠）を使う場合のみ設定。
# EIGALAND_ID=あなたのeigaland会員メールアドレス
# EIGALAND_PASSWORD=あなたのeigaland会員パスワード
